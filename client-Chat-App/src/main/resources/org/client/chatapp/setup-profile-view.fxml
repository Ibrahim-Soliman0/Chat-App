<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<AnchorPane prefHeight="650.0" prefWidth="450.0" style="-fx-background-color: #F5F5F5;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.client.chatapp.ui.controller.SetupProfileController">

    <VBox alignment="TOP_CENTER" spacing="15" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="40"
          AnchorPane.rightAnchor="40" AnchorPane.topAnchor="20">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                   text="Set Up Your Profile"/>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Complete your information"/>
        </VBox>

        <!-- Profile Image -->
        <StackPane>
            <!-- Circle Border -->
            <Circle fill="#ECEFF1" radius="50" stroke="WHITE" strokeWidth="3"/>

            <!-- Placeholder Icon -->
            <Group fx:id="profilePlaceholder">
                <SVGPath content="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" fill="transparent" stroke="#5e6468"
                         strokeWidth="2"/>
                <Circle centerX="12" centerY="7" fill="transparent" radius="4" stroke="#5e6468" strokeWidth="2"/>
            </Group>

            <!-- Profile Image -->
            <ImageView fx:id="profileImageView" fitHeight="100" fitWidth="100">
                <clip>
                    <Circle centerX="50" centerY="50" radius="50"/>
                </clip>
            </ImageView>

            <!-- Camera Button -->
            <StackPane onMouseClicked="#handleUploadPhoto" style="-fx-cursor: hand;" translateX="15" translateY="15"
                       StackPane.alignment="BOTTOM_RIGHT">
                <Circle fill="#00ab8a" radius="18" translateX="30.0" translateY="20.0"/>
                <Group translateX="30.0" translateY="20.0">
                    <SVGPath
                            content="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
                            fill="WHITE" stroke="WHITE" strokeWidth="2" style="-fx-fill: transparent;"/>
                    <Circle centerX="12" centerY="13" fill="transparent" radius="3" stroke="WHITE" strokeWidth="2"/>
                </Group>
            </StackPane>
        </StackPane>

        <!-- Form -->
        <ScrollPane fx:id="scrollPaneForm" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" styleClass="list-view">
            <VBox spacing="12" style="-fx-background-color: transparent;">

                <!-- Phone -->
                <VBox spacing="5">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;"
                           text="Phone Number"/>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: #E8ECEE; -fx-background-radius: 8; -fx-padding: 12;">
                        <!-- Phone Icon -->
                        <SVGPath fx:id="phoneIcon" fill="#00897B"/>
                        <TextField fx:id="phoneField" editable="false"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Full Name -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Full Name "/>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*"/>
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <TextField fx:id="nameField" promptText="Enter your name"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="nameError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Email " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <!-- Envelope Icon -->
                        <SVGPath fx:id="envelopeIcon" content="" fill="#00897B"/>
                        <TextField fx:id="emailField" promptText="your@email.com"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="emailError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Password " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <!-- Lock Icon -->
                        <SVGPath fx:id="lockIcon1" content="" fill="#00897B"/>
                        <PasswordField fx:id="passwordField" promptText="Enter password"
                                       style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                       HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="passwordError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <!-- Confirm Password -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Confirm Password " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <!-- Lock Icon -->
                        <SVGPath fx:id="lockIcon2" content="" fill="#00897B"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm password"
                                       style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                       HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="confirmPasswordError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;"
                           visible="false"/>
                </VBox>

                <!-- Gender -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Gender " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 5;">
                        <RadioButton fx:id="maleRadio" style="-fx-text-fill: #2C3E50;" text="Male">
                            <toggleGroup>
                                <ToggleGroup fx:id="genderGroup"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="femaleRadio" style="-fx-text-fill: #2C3E50;" text="Female"
                                     toggleGroup="$genderGroup"/>
                    </HBox>
                    <Label fx:id="genderError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <!-- Country -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Country " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <!-- Globe Icon -->
                        <SVGPath fx:id="globeIcon" content="" fill="#00897B"/>
                        <ComboBox fx:id="countryComboBox" prefWidth="280" promptText="Select your country"
                                  style="-fx-background-color: white; -fx-text-fill: black;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="countryError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <!-- Date of Birth -->
                <VBox spacing="5">
                    <TextFlow>
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #2C3E50;" text="Date of Birth " />
                        <Text style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: red;" text="*" />
                    </TextFlow>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-border-width: 1;">
                        <!-- Calendar Icon -->
                        <SVGPath fx:id="calendarIcon" content="" fill="#00897B"/>
                        <DatePicker fx:id="dobPicker" prefWidth="280" promptText="Select date" HBox.hgrow="ALWAYS">

                        </DatePicker>
                    </HBox>
                    <Label fx:id="dobError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

                <VBox spacing="5">
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Bio"/>
                    <TextArea fx:id="bioField" prefRowCount="4" promptText="Tell us about yourself"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0;"
                              wrapText="true"/>
                    <Label fx:id="bioCounter" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="0/150"/>
                    <Label fx:id="bioError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;" visible="false"/>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Create Account -->
        <Button fx:id="createAccountBtn" onAction="#handleCreateAccount" prefWidth="370"
                style="-fx-background-color: #00897B; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 15 0 15 0;"
                text="Create Account →">
            <font>
                <Font name="System Bold" size="16"/>
            </font>
        </Button>

        <!-- Terms -->
        <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="By continuing, you agree to our Terms"/>

    </VBox>

</AnchorPane>
