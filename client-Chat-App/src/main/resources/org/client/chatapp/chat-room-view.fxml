<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="450.0" style="-fx-background-color: #f7f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.client.chatapp.ui.controller.ChatRoomController">
    <children>
        <!-- Header -->
        <Pane prefHeight="75.0" prefWidth="450.0" style="-fx-background-color: #ffffff;">
            <effect>
                <DropShadow blurType="ONE_PASS_BOX" height="15.0" radius="3.25" spread="0.5" width="0.0" />
            </effect>
            <children>
                <!-- Back Button -->
                <Group fx:id="backButton" layoutX="15.0" layoutY="26.0" onMouseClicked="#onBackButtonClick" style="-fx-cursor: hand;">
                    <children>
                        <SVGPath fx:id="backArrow1" content="m12 19-7-7 7-7" style="-fx-stroke: #000000; -fx-stroke-width: 2; -fx-stroke-linecap: round; -fx-stroke-linejoin: round; -fx-fill: transparent;" />
                        <SVGPath fx:id="backArrow2" content="M19 12H5" style="-fx-stroke: #000000; -fx-stroke-width: 2; -fx-stroke-linecap: round; -fx-stroke-linejoin: round; -fx-fill: transparent;" />
                    </children>
                </Group>

                <!-- User Name -->
                <Label fx:id="chatUserName" layoutX="55.0" layoutY="16.0" text="User Name">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- User Status -->
                <Label fx:id="userStatus" layoutX="55.0" layoutY="45.0" text="Online" textFill="#25D366">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <!-- Messages List -->
        <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" hbarPolicy="NEVER" layoutY="75.0" prefHeight="500.0" prefWidth="450.0" style="-fx-background-color: #f7f9fa;" vbarPolicy="ALWAYS">
            <content>
                <VBox fx:id="messagesContainer" prefWidth="430.0" spacing="10.0" style="-fx-padding: 10;" />
            </content>
        </ScrollPane>

        <!-- Message Input Area -->
        <Pane layoutY="575.0" prefHeight="75.0" prefWidth="450.0" style="-fx-background-color: #ffffff;">
            <effect>
                <DropShadow blurType="ONE_PASS_BOX" height="15.0" radius="3.25" spread="0.5" width="0.0" />
            </effect>
            <children>
                <TextField fx:id="messageInput" layoutX="15.0" layoutY="20.0" prefHeight="35.0" prefWidth="350.0" promptText="Type a message..." style="-fx-background-color: #f0f0f0; -fx-background-radius: 18; -fx-padding: 0 15 0 15;" />

                <Button fx:id="sendButton" layoutX="380.0" layoutY="20.0" onAction="#onSendButtonClick" prefHeight="35.0" prefWidth="55.0" style="-fx-background-color: #00ab8a; -fx-background-radius: 18; -fx-text-fill: white; -fx-cursor: hand;" text="Send">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Button>
            </children>
        </Pane>
    </children>
</Pane>
