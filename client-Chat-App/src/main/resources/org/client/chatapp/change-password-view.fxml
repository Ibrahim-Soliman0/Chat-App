<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0"
      prefWidth="450.0" style="-fx-background-color: #f7f9fa;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.client.chatapp.ui.controller.ChangePasswordController">
   <children>
      <!-- Top Bar -->
      <Pane prefHeight="75.0" prefWidth="450.0" style="-fx-background-color: #ffffff;">
         <children>
            <Label layoutX="53.0" layoutY="16.0" text="Change Password">
               <font>
                  <Font name="System Bold" size="27.0" />
               </font>
            </Label>
            <StackPane alignment="CENTER" layoutX="14.0" layoutY="18.0" prefHeight="36" prefWidth="36"
                       style="-fx-background-color: #25D366; -fx-background-radius: 10; -fx-cursor: hand;">
               <children>
                  <SVGPath content="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"
                           style="-fx-stroke: white; -fx-stroke-width: 2; -fx-fill: transparent;" />
               </children>
            </StackPane>
         </children>
         <effect>
            <DropShadow blurType="ONE_PASS_BOX" height="15.0" radius="3.25" spread="0.5" width="0.0" />
         </effect>
      </Pane>

      <!-- Content Area -->
      <ScrollPane layoutY="75.0" prefHeight="500.0" prefWidth="450.0"
                  style="-fx-background-color: #f7f9fa; -fx-background: #f7f9fa;"
                  fitToWidth="true" hbarPolicy="NEVER">
         <content>
            <VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="450.0" spacing="20"
                  style="-fx-background-color: #f7f9fa;">
               <children>
                  <!-- Spacing at top -->
                  <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30 0 10 0;">
                     <children>
                        <Label text="Update your password"
                               style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                     </children>
                  </VBox>

                  <!-- Form Fields -->
                  <VBox prefWidth="390.0" spacing="15" style="-fx-padding: 0 30 20 30;">
                     <children>
                        <!-- Old Password -->
                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Old Password" />
                              <HBox alignment="CENTER_LEFT" spacing="10"
                                    style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 15;">
                                 <children>
                                    <PasswordField fx:id="oldPasswordField" promptText="Enter old password"
                                                   style="-fx-background-color: transparent; -fx-border-width: 0;"
                                                   HBox.hgrow="ALWAYS" />
                                 </children>
                                 <effect>
                                    <DropShadow blurType="GAUSSIAN" color="#00000020" height="5.0" radius="2.0"
                                                spread="0.1" width="5.0" />
                                 </effect>
                              </HBox>
                              <Label fx:id="oldPasswordError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;"
                                     visible="false"/>
                           </children>
                        </VBox>

                        <!-- New Password -->
                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="New Password" />
                              <HBox alignment="CENTER_LEFT" spacing="10"
                                    style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 15;">
                                 <children>
                                    <PasswordField fx:id="newPasswordField" promptText="Enter new password"
                                                   style="-fx-background-color: transparent; -fx-border-width: 0;"
                                                   HBox.hgrow="ALWAYS" />
                                 </children>
                                 <effect>
                                    <DropShadow blurType="GAUSSIAN" color="#00000020" height="5.0" radius="2.0"
                                                spread="0.1" width="5.0" />
                                 </effect>
                              </HBox>
                              <Label fx:id="newPasswordError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;"
                                     visible="false"/>
                           </children>
                        </VBox>

                        <!-- Confirm New Password -->
                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Confirm New Password" />
                              <HBox alignment="CENTER_LEFT" spacing="10"
                                    style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 15;">
                                 <children>
                                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"
                                                   style="-fx-background-color: transparent; -fx-border-width: 0;"
                                                   HBox.hgrow="ALWAYS" />
                                 </children>
                                 <effect>
                                    <DropShadow blurType="GAUSSIAN" color="#00000020" height="5.0" radius="2.0"
                                                spread="0.1" width="5.0" />
                                 </effect>
                              </HBox>
                              <Label fx:id="confirmPasswordError" style="-fx-text-fill: #E74C3C; -fx-font-size: 11px;"
                                     visible="false"/>
                           </children>
                        </VBox>

                        <!-- Update Password Button -->
                        <Button fx:id="updatePasswordButton" text="Update Password" onAction="#onUpdatePasswordClick"
                                prefWidth="390.0" prefHeight="45.0"
                                style="-fx-background-color: #25D366; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-font-size: 16px;
                                       -fx-font-weight: bold; -fx-cursor: hand;">
                           <effect>
                              <DropShadow blurType="GAUSSIAN" height="5.0" radius="2.0"
                                          spread="0.1" width="5.0" color="#00000030"/>
                           </effect>
                        </Button>

                        <!-- Cancel Button -->
                        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick"
                                prefWidth="390.0" prefHeight="45.0"
                                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333;
                                       -fx-background-radius: 10; -fx-font-size: 16px;
                                       -fx-font-weight: bold; -fx-cursor: hand;">
                           <effect>
                              <DropShadow blurType="GAUSSIAN" height="5.0" radius="2.0"
                                          spread="0.1" width="5.0" color="#00000030"/>
                           </effect>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Bottom Navigation Bar -->
      <Pane layoutY="575.0" prefHeight="75.0" prefWidth="450.0" style="-fx-background-color: #ffffff;">
         <children>
            <Group fx:id="profileIcon" layoutX="363.0" layoutY="25.0" onMouseClicked="#onProfileIconClick" />
            <Group fx:id="chatsIcon" layoutX="94.0" layoutY="25.0" onMouseClicked="#onChatsIconClick" />
         </children>
         <effect>
            <DropShadow blurType="ONE_PASS_BOX" height="15.0" radius="3.25" spread="0.5" width="0.0" />
         </effect>
      </Pane>
   </children>
</Pane>