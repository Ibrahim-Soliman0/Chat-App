<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane
        stylesheets="@../../../css/admin.css"
        fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f5f5f5;" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.server.chatapp.ui.controller.StatisticsController">

    <content>
        <VBox spacing="20.0" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
            </padding>

            <children>
                <VBox spacing="5">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Platform Statistics" />
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Real-time data across all users and countries." />
                </VBox>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Online Users" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblOnlineCount" style="-fx-text-fill: #14b8a6; -fx-font-weight: bold;" text="0 Online" />
                                <Label style="-fx-text-fill: #94a3b8;" text=" / " />
                                <Label fx:id="lblTotalCount" style="-fx-text-fill: #64748b;" text="0 Total" />
                            </children>
                        </HBox>
                        <StackPane alignment="CENTER_LEFT">
                            <children>
                                <Rectangle fx:id="rectTotal" height="15.0" styleClass="progress-track" width="600.0" />
                                <Rectangle fx:id="rectOnline" height="15.0" styleClass="progress-fill" width="0.0" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <PieChart fx:id="genderChart" prefHeight="300.0" title="Gender Distribution" />
                            </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <BarChart fx:id="countryChart" legendVisible="false" prefHeight="300.0" title="Users by Country">
                                    <xAxis><CategoryAxis side="BOTTOM" fx:id="xAxis" /></xAxis>
                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                </BarChart>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
