<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.web.HTMLEditor?>

<?import javafx.scene.control.TextField?>
<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.server.chatapp.ui.controller.AnnouncementController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <children>
        <VBox spacing="5">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                   text="Global Announcements"/>
            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"
                   text="Create and broadcast rich-text HTML messages to all online users."/>
        </VBox>

        <VBox spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
              VBox.vgrow="ALWAYS">
            <Label text="Announcement Title" style="-fx-font-weight: bold;"/>
            <TextField fx:id="titleField" promptText="Enter announcement title..."
                       style="-fx-padding: 10; -fx-background-radius: 8;"/>

            <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;"
                   text="Announcement Content"/>

            <HTMLEditor fx:id="htmlEditor" prefHeight="400.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 5;"
                        VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button fx:id="btnClear" onAction="#handleClearButton"
                        style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-weight: bold;"
                        text="Clear"/>
                <Button fx:id="btnSend" onAction="#handleSendAnnouncement"
                        style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8;"
                        text="SEND NOW">
                    <graphic>
                        <SVGPath content="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" fill="TRANSPARENT" stroke="WHITE"
                                 strokeWidth="2"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </children>
</VBox>
