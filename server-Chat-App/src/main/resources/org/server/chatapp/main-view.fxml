<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane
        fx:id="root"
        prefHeight="700.0"
        prefWidth="1050.0"
        style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21"

        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.server.chatapp.ui.controller.AdminDashboardController">

    <left>
        <VBox prefWidth="250.0" spacing="5.0"
              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <padding>
                        <Insets bottom="30.0" top="30.0"/>
                    </padding>
                    <children>
                        <StackPane>
                            <Circle radius="30.0" style="-fx-fill: #14b8a6;"/>
                            <SVGPath content="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" fill="WHITE"/>
                        </StackPane>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1f2937;"
                               text="Admin Dashboard"/>
                    </children>
                </VBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets left="15.0" right="15.0"/>
                    </padding>
                    <children>
                        <Button fx:id="btnControl" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: #14b8a6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Start/Stop">
                            <graphic>
                                <Group>
                                    <SVGPath
                                            content="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"
                                            fill="TRANSPARENT" stroke="WHITE" strokeWidth="1.5"/>
                                </Group>
                            </graphic>
                        </Button>

                        <Button fx:id="btnStatistics" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-cursor: hand;"
                                text=" Statistics">
                            <graphic>
                                <Group>
                                    <SVGPath content="M21.21 15.89A10 10 0 1 1 8 2.83M22 12A10 10 0 0 0 12 2v10z"
                                             fill="TRANSPARENT" stroke="#4b5563" strokeWidth="1.5"/>
                                </Group>
                            </graphic>
                        </Button>

                        <Button fx:id="btnAnnouncements" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-cursor: hand;"
                                text=" Announcements">
                            <graphic>
                                <Group>
                                    <SVGPath
                                            content="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14 M8 6v8"
                                            fill="TRANSPARENT" stroke="#4b5563" strokeWidth="1.5"/>
                                </Group>
                            </graphic>
                        </Button>

                        <Button fx:id="btnUsers" alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-cursor: hand;"
                                text=" User Management">
                            <graphic>
                                <Group>
                                    <children>
                                        <SVGPath content="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" fill="TRANSPARENT"
                                                 stroke="#4b5563" strokeWidth="1.5"/>
                                        <SVGPath content="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" fill="TRANSPARENT"
                                                 stroke="#4b5563" strokeWidth="1.5"/>
                                        <SVGPath content="M16 3.13a4 4 0 0 1 0 7.75" fill="TRANSPARENT" stroke="#4b5563"
                                                 strokeWidth="1.5"/>
                                        <SVGPath content="M22 21v-2a4 4 0 0 0-3-3.87" fill="TRANSPARENT"
                                                 stroke="#4b5563" strokeWidth="1.5"/>
                                    </children>
                                </Group>
                            </graphic>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea" spacing="20.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="2">
                            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Dashboard Overview"/>
                            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"
                                   text="Welcome back, Administrator."/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER" spacing="10.0"
                              style="-fx-background-color: white; -fx-padding: 8 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <children>
                                <Circle fx:id="statusCircle" fill="#ef4444" radius="5.0"/>
                                <Label fx:id="lblStatus"
                                       style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;"
                                       text="SERVER OFFLINE"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <VBox alignment="CENTER" maxHeight="450.0" maxWidth="450.0" spacing="25.0"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <padding>
                                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                            </padding>
                            <children>
                                <StackPane prefHeight="80" prefWidth="80">
                                    <Circle radius="40.0" style="-fx-fill: #f3f4f6;"/>
                                    <SVGPath content="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="#14b8a6" scaleX="2.0"
                                             scaleY="2.0"/>
                                </StackPane>
                                <VBox alignment="CENTER" spacing="8">
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;"
                                           text="RMI Service Control"/>
                                    <Label style="-fx-text-fill: #6b7280; -fx-text-alignment: center; -fx-font-size: 14px;"
                                           text="Click the button below to initialize the RMI Registry and allow users to login to the ChatApp."
                                           wrapText="true"/>
                                </VBox>
                                <Button fx:id="btnStartStop"
                                        maxWidth="Infinity"
                                        onAction="#handleStartStop"
                                        prefHeight="50.0"
                                        text="START SERVICE"/>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </VBox>
    </center>
</BorderPane>